# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/portfolio

# Public URL of the site, used for metadata and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin access. Generate the hash with: pnpm admin:hash "your-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# Random string of 32+ chars, used to sign the admin session and hash visitor ids
SESSION_SECRET=

# Cloudinary (Settings > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
