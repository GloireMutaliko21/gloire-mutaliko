# Supabase (Project Settings > API Keys). Locally, `supabase status` prints them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Publishable key: safe in the browser, only used to send files to signed upload URLs
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only, never expose it
SUPABASE_SECRET_KEY=
# Storage bucket created by the migration
SUPABASE_BUCKET=portfolio

# Public URL of the site, used for metadata and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin access. Generate the hash with: pnpm admin:hash "your-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# Random string of 32+ chars, used to sign the admin session and hash visitor ids
SESSION_SECRET=
